{% comment %}
  The About block: portrait beside the bio.

  Why this is a custom section rather than Dawn's image-with-text: that section takes its
  image from an `image_picker`, which stores a reference to a file uploaded in the Shopify
  admin. The portrait here ships with the theme, in assets/, so it can be version
  controlled alongside the copy. `asset_url` is the only way to reach it.

  Trade-off, recorded honestly: a theme asset does not go through Shopify's image CDN, so
  there is no automatic srcset. The file is pre-sized to 1000px wide, which covers the
  ~500px it renders at on a 2x display. If the portrait is later uploaded through
  Settings → Files, this section should be replaced by Dawn's image-with-text to get
  responsive variants for free.
{% endcomment %}

{{ 'tb-about.css' | asset_url | stylesheet_tag }}

<div class="tb-about color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width tb-about__inner tb-about__inner--{{ section.settings.image_position }}">
    <div class="tb-about__media">
      {%- comment -%}
        width/height and the CSS aspect-ratio both come from the real file, so the space is
        reserved before it loads and nothing shifts.
      {%- endcomment -%}
      <img
        src="{{ 'tb-portrait.jpg' | asset_url }}"
        alt="{{ section.settings.image_alt | escape }}"
        width="1000"
        height="1334"
        loading="lazy"
        decoding="async"
        class="tb-about__img"
      >
    </div>

    <div class="tb-about__body">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 class="tb-about__heading" {{ block.shopify_attributes }}>
              {{- block.settings.heading | escape -}}
            </h2>
          {%- when 'label' -%}
            <p class="tb-about__label" {{ block.shopify_attributes }}>
              {{- block.settings.label | escape -}}
            </p>
          {%- when 'text' -%}
            <div class="tb-about__text rte" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {%- when 'button' -%}
            {%- if block.settings.button_label != blank -%}
              <a
                class="tb-about__button"
                href="{{ block.settings.button_link | default: '/' }}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.button_label | escape -}}
              </a>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About the photographer",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Portrait position",
      "options": [
        { "value": "image-left", "label": "Left" },
        { "value": "image-right", "label": "Right" }
      ],
      "default": "image-left"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Portrait alt text",
      "default": "Tom Bannerman standing on a ridge with a film camera"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "About" }
      ]
    },
    {
      "type": "label",
      "name": "Label",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "EARTH collection" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About the photographer",
      "blocks": [{ "type": "heading" }, { "type": "text" }]
    }
  ]
}
{% endschema %}
